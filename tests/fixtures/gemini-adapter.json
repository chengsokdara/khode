  {
    "name": "tool conversation — functionCall args object + functionResponse bound by name",
    "adapter": "gemini",
    "apiKeyPlain": "sk-gem-mock",
    "cand": {
      "model": {
        "upstreamModel": "gemini-2.5-flash"
      },
      "provider": {
        "name": "Gemini (smoke)",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
      },
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
    },
    "req": {
      "messages": [
        {
          "role": "user",
          "content": "Weather in Paris?",
          "extra": {}
        },
        {
          "role": "assistant",
          "content": "",
          "toolCalls": [
            {
              "id": "call_gemini_0",
              "name": "get_weather",
              "arguments": "{\"city\":\"Paris\"}"
            }
          ],
          "extra": {}
        },
        {
          "role": "tool",
          "content": "18C",
          "toolCallId": "call_gemini_0",
          "extra": {}
        }
      ],
      "stream": false,
      "options": {},
      "extras": {}
    },
    "expected": {
      "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
      "headers": {
        "x-goog-api-key": "sk-gem-mock",
        "content-type": "application/json"
      },
      "body": {
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "Weather in Paris?"
              }
            ]
          },
          {
            "role": "model",
            "parts": [
              {
                "functionCall": {
                  "name": "get_weather",
                  "args": {
                    "city": "Paris"
                  }
                }
              }
            ]
          },
          {
            "role": "user",
            "parts": [
              {
                "functionResponse": {
                  "name": "get_weather",
                  "response": {
                    "result": "18C"
                  }
                }
              }
            ]
          }
        ]
      },
      "timeoutMs": 60000
    }
  },
