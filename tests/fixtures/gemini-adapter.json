  {
    "name": "vision — data URL → inlineData, https URL → fileData (native multiparts)",
    "adapter": "gemini",
    "apiKeyPlain": "sk-gem-mock",
    "cand": {
      "model": {
        "upstreamModel": "gemini-2.5-flash"
      },
