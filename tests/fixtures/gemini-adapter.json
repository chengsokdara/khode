  {
    "name": "system + developer fold into systemInstruction; options map onto generationConfig",
    "adapter": "gemini",
    "apiKeyPlain": "sk-gem-mock",
    "cand": {
      "model": {
        "upstreamModel": "gemini-2.5-flash"
      },
      "provider": {
        "name": "Gemini (smoke)",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
      },
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
    },
    "req": {
      "messages": [
        {
          "role": "system",
          "content": "Be terse.",
          "extra": {}
        },
        {
          "role": "developer",
          "content": "No markdown.",
          "extra": {}
        },
        {
          "role": "user",
          "content": "hi",
          "extra": {}
        }
      ],
      "stream": false,
      "options": {
        "temperature": 0.5,
        "topP": 0.9,
        "maxTokens": 512,
        "maxTokensField": "max_tokens",
        "stop": [
          "END",
          "STOP"
        ]
      },
      "extras": {}
    },
    "expected": {
      "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
      "headers": {
        "x-goog-api-key": "sk-gem-mock",
        "content-type": "application/json"
      },
      "body": {
        "systemInstruction": {
          "parts": [
            {
              "text": "Be terse.\n\nNo markdown."
            }
          ]
        },
        "contents": [
          {
            "role": "user",
            "parts": [
              {
                "text": "hi"
              }
            ]
          }
        ],
        "generationConfig": {
          "temperature": 0.5,
          "topP": 0.9,
          "maxOutputTokens": 512,
          "stopSequences": [
            "END",
            "STOP"
          ]
        }
      },
      "timeoutMs": 60000
    }
  },
