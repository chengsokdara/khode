              "thinking": "hmm",
              "signature": "x"
            }
          ]
        }
      ]
    },
    "expected": {
      "ok": true,
      "model": "claude-sonnet-4-5",
      "request": {
        "messages": [
          {
            "role": "user",
            "content": "",
            "reasoning": {
              "text": "hmm",
              "signature": "x"
            },
            "extra": {}
          }
        ],
        "stream": false,
        "options": {
          "tools": null,
          "toolChoice": null,
          "maxTokens": 64,
          "maxTokensField": "max_tokens",
          "stop": null
        },
        "extras": {}
      }
    }
  },
