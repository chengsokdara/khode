            "role": "user",
            "content": "look",
            "images": [
              {
                "url": "https://example.com/cat.jpg"
              }
            ],
            "extra": {}
          }
        ],
        "options": {
          "tools": null,
          "toolChoice": null,
          "maxTokens": 64,
          "maxTokensField": "max_tokens",
          "stop": null
        },
        "extras": {}
      }
    }
  },
