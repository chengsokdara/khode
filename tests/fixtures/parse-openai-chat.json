    "expected": {
      "ok": false,
      "status": 400,
      "message": "tools[0]: tool type 'web_search' is vendor-hosted and cannot be routed across dialects — only 'function' tools are supported",
      "param": "tools",
      "code": null
    }
  },
  {
    "name": "non-http(s) image URL rejected",
    "body": {
      "model": "gpt-5",
      "messages": [
        {
          "role": "user",
          "content": [
            {
              "type": "text",
              "text": "look"
