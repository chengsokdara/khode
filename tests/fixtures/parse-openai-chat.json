  {
    "name": "M18: response_format json_schema (openai-chat nesting) → canonical",
    "body": {
      "model": "gpt-5",
      "messages": [
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "response_format": {
        "type": "json_schema",
        "json_schema": {
          "name": "calendar",
          "strict": true,
          "schema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              }
            },
            "required": [
              "date"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "expected": {
      "ok": true,
      "model": "gpt-5",
      "request": {
        "messages": [
          {
            "role": "user",
            "content": "hi",
            "extra": {}
          }
        ],
        "stream": false,
        "responseFormat": {
          "type": "json_schema",
          "name": "calendar",
          "schema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              }
            },
            "required": [
              "date"
            ],
            "additionalProperties": false
          },
          "strict": true
        },
        "options": {
          "tools": null,
          "toolChoice": null,
          "parallelToolCalls": null
        },
        "extras": {}
      }
    }
  },
  {
    "name": "M18: response_format unknown type → 400 explicit",
    "body": {
      "model": "gpt-5",
      "messages": [
        {
          "role": "user",
          "content": "hi"
        }
      ],
