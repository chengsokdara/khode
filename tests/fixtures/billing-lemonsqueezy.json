[
  {
    "name": "order_created paid, subtotal/discount breakdown present",
    "payload": {
      "meta": {
        "event_name": "order_created",
        "custom_data": { "user_id": "usr_1" },
        "test_mode": false
      },
      "data": {
        "type": "orders",
        "id": "101",
        "attributes": {
          "store_id": 7,
          "identifier": "order_abc",
          "user_email": "buyer@example.com",
          "currency": "USD",
          "subtotal": 1000,
          "discount_total": 200,
          "tax": 0,
          "total": 800,
          "status": "paid",
          "refunded": false
        }
      }
    },
    "expected": {
      "eventName": "order_created",
      "eventKey": "order_created:101",
      "orderId": "101",
      "userId": "usr_1",
      "orgId": null,
      "status": "paid",
      "refunded": false,
      "currency": "USD",
      "subtotalCents": 1000,
      "discountCents": 200,
      "totalCents": 800,
      "userEmail": "buyer@example.com"
    },
    "creditMicros": 8000000
  },
