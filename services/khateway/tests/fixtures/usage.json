     "delta": {
      "type": "text_delta",
      "text": "hi"
     }
    }
   },
   {
    "event": "message_delta",
    "data": {
     "type": "message_delta",
     "delta": {
      "stop_reason": "end_turn"
     },
     "usage": {
      "output_tokens": 59
     }
    }
   },
   {
    "event": "message_stop",
    "data": {
     "type": "message_stop"
    }
   }
  ],
  "expected": {
   "tokensIn": 23,
   "tokensOut": 59
  }
 },
