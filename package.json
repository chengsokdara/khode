{
  "name": "khateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev --port 8787 --test-scheduled",
    "dev:prod": "npm run -s build:web && wrangler dev --port 8787 --test-scheduled",
    "build:web": "vite build",
    "check": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply khateway --local",
    "deploy": "npm run -s build:web && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "smoke:gateway": "node scripts/smoke_gateway.mjs",
    "smoke:device": "node scripts/smoke_device.mjs",
    "smoke:oauth": "node scripts/smoke_oauth.mjs",
    "smoke:m8": "node scripts/smoke_m8.mjs",
    "smoke:m9": "node scripts/smoke_m9.mjs",
    "smoke:m10": "node scripts/smoke_m10.mjs",
    "smoke:m11": "node scripts/smoke_m11.mjs",
    "smoke:m14": "node scripts/smoke_m14.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260916.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
